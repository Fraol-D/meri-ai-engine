# Optional. Recognized English sales, purchases, expenses, debts,
# inventory notes, and questions work without this key.
# Unrecognized phrasing is sent to the Gemini API only when the key is set.
GEMINI_API_KEY=

# Optional overrides. gemini-3.1-flash-lite supports structured JSON
# and is available on the Gemini API free tier.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Browser origins allowed to call this service (comma-separated). No credentials.
# Defaults include local Next.js and the production Vercel frontend.
CORS_ORIGINS=http://localhost:3000,https://voice-first-business-assistant.vercel.app
